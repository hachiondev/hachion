# Local/server env files for secrets such as TWILIO_ACCOUNT_SID /
# TWILIO_AUTH_TOKEN - never committed, regardless of name/location.
.env
.env.*
!.env.example

# Stray backup files left next to live source during editing - never meant
# to be committed, and some previously carried since-removed secrets.
*.bak

# Real uploaded student/course files and generated certificates - runtime
# data, not source, and contains real student PII.
/uploads/
/certificates/

