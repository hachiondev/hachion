# Copy to .env (or export these into the actual process environment on the
# host running the jar) and fill in real values. Never commit the filled-in
# version - only this .example file with placeholders is tracked.
#
# Every variable below has a matching ${VAR:...} placeholder in
# src/main/resources/application*.properties. Vars with no default in the
# properties file (secrets) MUST be set for that feature to work; vars with
# a default (paths) only need to be set to override that default.

# --- Database ---
DB_USERNAME=root
DB_PASSWORD=1234

# --- SMTP / outgoing email ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- Google OAuth (Sign-In) ---
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Google Chat webhooks (visitor-tracking / internal notifications) ---
GOOGLE_CHAT_WEBHOOK_URL=
GCHAT_WEBHOOK_URL=

# --- Twilio (WhatsApp / SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- OpenAI ---
OPENAI_API_KEY=

# --- YouTube Data API ---
YOUTUBE_API_KEY=

# --- Vitel (call records) ---
VITEL_PASSWORD=

# --- Upload/certificate storage paths ---
# Defaults in application-{prod,test,dev}.properties already match this
# server's current layout - only set these if that layout changes.
UPLOAD_BASE_PATH=
STATIC_UPLOADS_PATH=
UPLOAD_ALL_IMAGES_PATH=
PAYMENTS_UPLOAD_PATH=
INVOICE_PATH=
CERTIFICATE_PATH=
FILE_UPLOAD_DIR=
HIREFROMUS_UPLOAD_DIR=
IMAGE_UPLOAD_PATH=
IMAGE_UPLOAD_USERREVIEW_PATH=
IMAGE_UPLOAD_CORPORATEREVIEW_PATH=
FILE_UPLOAD_INSTRUCTOR_RESUME_PATH=
APPLYJOB_RESUME_UPLOAD_DIR=
USER_PROFILE_IMAGE_UPLOAD_DIR=
IMAGE_UPLOAD_EMPLOYEE_COMPANY_IMAGE_PATH=
TRAINER_UPLOAD_DIR=
TOOLS_IMAGES_UPLOAD_PATH=
BANNER_IMAGE_UPLOAD_PATH=
INTERVIEW_UPLOAD_DIR=
